# Másold .env.local néven, és töltsd ki (Vercelen: Settings → Environment Variables)

# KÖTELEZŐ élesben: az admin felület jelszava (helyben enélkül „konyha”)
ADMIN_PASSWORD=

# Adatbázis: Vercel → Storage → Upstash for Redis → Connect. A Vercel magától beállítja:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Képtárhely: Vercel → Storage → Blob → Connect. A Vercel magától beállítja:
BLOB_READ_WRITE_TOKEN=

# Nem kötelező
# SITE_URL=https://www.sajatdomain.hu
# SESSION_SECRET=hosszu-veletlen-szoveg
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
